# Required for Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional but recommended for stronger platform coverage
TM_API_KEY=
EVENTBRITE_TOKEN=

# Optional monitor tuning
TRACKED_KEYWORDS=Dublin,Kerry,Mayo,Cork,Galway,All-Ireland,Semi Final,Final,Hurling,Football,Croke Park,Leinster,Munster,Ulster
REQUIRE_MATCHING_KEYWORDS=true
FUZZY_MATCH_ENABLED=true
FUZZY_MATCH_THRESHOLD=0.86
LOG_LEVEL=INFO
REQUEST_TIMEOUT=20
MAX_WORKERS=5
DEFAULT_RATE_LIMIT_SECONDS=1.0
HTTP_RETRY_TOTAL=3
HTTP_RETRY_BACKOFF=1.0
HEALTHCHECK_VERBOSE=true
